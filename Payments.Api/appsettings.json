{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "KamaPayments.Api",
    "Audience": "KamaPayments.Client",
    "ExpiryMinutes": 60
  },
  "PaymentProvider": {
    "AttemptTimeoutSeconds": 3,
    "TotalTimeoutSeconds": 20,
    "MaxRetryAttempts": 3
  },
  "BackgroundJobs": {
    "RetryIntervalMinutes": 1,
    "BatchSize": 100
  }
}